---
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
---
<a href={`/blog/${post.id}`} class="flex flex-col rounded-sm align-middle gap-4 relative max-w-md min-w-sm group">
  <img src={post.data.image.url} alt={post.data.image.alt} class="w-full aspect-6/4 object-cover rounded-md">
  <div class="flex flex-col col-span-2 justify-center gap-0 md:gap-1 absolute bottom-0 left-0 right-0 bg-black/70 p-4 rounded-md group-hover:bg-black transition-colors">
    <p class="text-sm text-light/80">{post.data.pubDate.toDateString()}</p>
    <p class="text-lg text-primary/85">{post.data.title}</p>
    <p class="text-sm text-light/80">{post.data.description}</p>
  </div>
</a>
