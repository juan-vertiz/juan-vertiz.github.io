---
import Hamburger from './Hamburger.astro';
import Navbar from './Navbar.astro';

const { activeItem } = Astro.props;
---
<header class="relative flex overflow-visible bg-black border-b border-light/25">
  <span class="hidden sm:inline w-16 border-r border-light/25"></span>
  <a href="/" class="flex items-center text-5xl uppercase mr-auto px-8 font-bold text-primary">JV</a>
  <Hamburger />
  <Navbar activeItem={activeItem} />
  <span class="hidden sm:inline w-24 border-l border-light/25"></span>
</header>
