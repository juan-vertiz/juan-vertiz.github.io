---
import '../styles/global.css';
import { Font } from 'astro:assets';
import Header from '../components/Header.astro';

interface Props {
  pageTitle: string;
  activeItem: string;
  ogImage?: {
    title: string,
    description: string,
    url: string,
  }
}

const { pageTitle, activeItem, ogImage } = Astro.props;
---
<html lang="en">
<head>
  <meta charset="UTF-8">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="generator" content={Astro.generator}>
  <title>{pageTitle}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <Font cssVariable="--font-quantico" />
  <meta property="og:title" content={ogImage?.title ?? 'Juan Vertiz'}>
  <meta property="og:description" content={ogImage?.description ?? 'Portfolio & Blog'}>
  <meta property="og:image" content={ogImage?.url ?? `${Astro.site}assets/images/2025-10-23.jpeg`}>
</head>
<body class="bg-dark text-light font-quantico">
  <Header activeItem={activeItem} />
  <main class="mx-8 sm:mx-32 mt-8 mb-16">
    <slot />
  </main>
</body>
</html>
