---
import BaseLayout from './BaseLayout.astro';
import '../styles/markdown.css';
import 'remark-github-blockquote-alert/alert.css';

const { frontmatter } = Astro.props;
---
<BaseLayout pageTitle={`Juan Vertiz | ${frontmatter.title}`} activeItem="blog">
  <div class="max-w-4xl min-w-xs mx-auto">
    <img src={frontmatter.image.url} alt={frontmatter.image.alt} class="w-full mx-auto aspect-9/4 object-cover rounded-md my-6">
    <p class="italic text-sm mb-2">Posted on {frontmatter.pubDate.toLocaleDateString()}</p>
    <div class="flex gap-2 mb-8 flex-wrap">{frontmatter.tags.map((tag: string) => <div class="text-dark text-sm bg-primary px-2">{tag}</div>)}</div>
    <div id="post">
      <slot />
    </div>
  </div>
</BaseLayout>
