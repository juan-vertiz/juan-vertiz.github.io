---
import BaseLayout from '../layouts/BaseLayout.astro';
import LinkExternal from '../components/LinkExternal.astro';
import MainIcon from '../assets/images/shape-1.svg';
---
<BaseLayout pageTitle="Juan Vertiz" activeItem="home">
  <div class="">
    <p class="text-lg text-primary uppercase mb-6"><span>// </span>Hello, I'm</p>
    <h1 class="text-6xl font-bold uppercase mb-6">Juan Vertiz</h1>
    <h2 class="text-2xl font-semibold text-primary uppercase mb-6 min-w-sm">Software Developer & Automation Engineer<span>_</span></h2>
    <p class="text-lg mb-16 min-w-sm">I design, implement, and maintain reliable back-end services and test automation frameworks.</p>
    <div class="flex flex-col w-full sm:w-fit gap-2">
      <div class="flex">
        <span class="inline-flex border-t-2 border-l-2 border-primary w-4 h-4"></span>
        <p class="text-sm text-primary uppercase mx-4">Links</p>
        <span class="inline-flex border-r-2 border-b-2 border-primary flex-1 h-4"></span>
      </div>
      <div class="flex gap-4">
        <LinkExternal text='GitHub' href='https://github.com/juan-vertiz/' iconPath='/src/assets/images/github.svg'/>
        <LinkExternal text='LinkedIn' href='https://www.linkedin.com/in/juan-vertiz/' iconPath='/src/assets/images/linkedin.svg'/>
      </div>
    </div>
  </div>
</BaseLayout>
